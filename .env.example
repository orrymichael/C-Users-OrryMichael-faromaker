# Copy to .env for local development. Never commit .env. In FaroMaker, Hub injects the PostHog values and you set the others as app secrets.

# Frontend (Vite): injected by Hub when PostHog is connected (App > Services > PostHog)
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=

# Backend
PORT=3000
MONDAY_TOKEN=               # Monday API token (kept on the server only)
FAROS_BASE_URL=             # FarOS API base URL
FAROS_API_KEY=              # read-only FarOS key
# FAROS_AUTH_HEADER=Authorization   # header name FarOS expects
# FAROS_AUTH_SCHEME=Bearer          # set empty for a raw key
# FAROMAKER_USER_HEADER=x-faromaker-user-id   # request header carrying the signed-in FaroMaker user id (confirm with the platform)
